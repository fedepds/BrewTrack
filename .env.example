# Usar solo caracteres seguros para URL (p. ej. `openssl rand -hex 24`).
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-with-at-least-32-characters

# Zona horaria del taller (opcional). Define dónde empieza cada mes en el resumen.
TIMEZONE=America/Argentina/Buenos_Aires

# Carga 20 lotes y 24 tuestes de ejemplo al iniciar, si la base no tiene lotes ni tuestes.
# Con compose vale true si no la defines. Pon false para instalar el taller real sin datos de ejemplo.
SEED_DEMO_LOTS=true
