server {
  listen 8080;
  root /usr/share/nginx/html;
  index index.html;

  location /api/ {
    # DNS de la red, tomado de /etc/resolv.conf al arrancar (NGINX_LOCAL_RESOLVERS).
    # Con variable en proxy_pass, nginx vuelve a resolver "api" tras cada TTL.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=5s;
    set $api_upstream ${API_UPSTREAM};
    # Sin ruta en proxy_pass, nginx reenvía la URI original con su query.
    proxy_pass $api_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
